---
// Figura con un dibujo SVG: título y descripción para lectores de pantalla y un pie visible.
interface Props { titulo: string; descripcion: string; pie: string; ancho?: number; alto: number }
const { titulo, descripcion, pie, ancho = 720, alto } = Astro.props;
const id = 'esq-' + titulo.toLowerCase().normalize('NFD').replace(/[^a-z0-9]+/g, '-');
---
<figure class="esquema">
  <div class="lienzo">
    <svg viewBox={`0 0 ${ancho} ${alto}`} role="img" aria-labelledby={`${id}-t ${id}-d`}>
      <title id={`${id}-t`}>{titulo}</title>
      <desc id={`${id}-d`}>{descripcion}</desc>
      <defs>
        <marker id={`${id}-f`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 L10 5 L0 10 z" class="punta" />
        </marker>
      </defs>
      <g style={`--flecha: url(#${id}-f)`}><slot /></g>
    </svg>
  </div>
  <figcaption>{pie}</figcaption>
</figure>
