---
// Un dato de la práctica de películas cruzando las cinco representaciones, con el mapper de cada frontera.
import Esquema from '../Esquema.astro';
const capas = [
  { t: 'JSON de la API', d: 'controller.api · record', n: ['codigo', 'titulo', 'anioEstreno', 'duracionMinutos'] },
  { t: 'Petición al servicio', d: 'service.modelo · record', n: ['referenciaSolicitada', 'nombreSolicitado', 'anioSolicitado', 'minutosSolicitados'] },
  { t: 'Dominio', d: 'model · clase', n: ['identificador', 'nombre', 'anioLanzamiento', 'minutosProyeccion'] },
  { t: 'Fila en Java', d: 'repository.jdbc · clase', n: ['codigoFila', 'tituloFila', 'anioFila', 'minutosFila'] },
  { t: 'Columna SQLite', d: 'tabla peliculas', n: ['pelicula_codigo', 'titulo_texto', 'estreno_anio', 'duracion_minutos'] },
];
const mappers = ['PeliculaApiMapper', 'PeliculaDominioMapper', 'PeliculaEntityMapper', 'PeliculaRowMapper'];
const ancho = 176;
const hueco = 34;
const x = (i: number) => 10 + i * (ancho + hueco);
---
<Esquema titulo="El viaje de un dato entre capas" ancho={1000} alto={330}
  descripcion="Cinco cajas de izquierda a derecha, una por representación del mismo dato. JSON de la API: codigo, titulo, anioEstreno, duracionMinutos. Petición al servicio: referenciaSolicitada, nombreSolicitado, anioSolicitado, minutosSolicitados. Dominio: identificador, nombre, anioLanzamiento, minutosProyeccion. Fila en Java: codigoFila, tituloFila, anioFila, minutosFila. Columna SQLite: pelicula_codigo, titulo_texto, estreno_anio, duracion_minutos. Entre cada par de cajas hay una flecha numerada: 1 PeliculaApiMapper, 2 PeliculaDominioMapper, 3 PeliculaEntityMapper, 4 PeliculaRowMapper."
  pie="Cada capa llama al dato de una forma distinta, así que ninguna puede usar el objeto de otra sin pasar por un mapper. Al volver, PeliculaRowMapper lee la fila, PeliculaEntityMapper crea la Pelicula y PeliculaApiMapper construye la respuesta.">
  {capas.map((c, i) => (
    <g>
      <rect x={x(i)} y="20" width={ancho} height="200" rx="8" class="caja" />
      <text x={x(i) + 14} y="48" class="t-titulo">{c.t}</text>
      <text x={x(i) + 14} y="70" class="t-suave">{c.d}</text>
      <path d={`M${x(i) + 14} 84 H${x(i) + ancho - 14}`} class="trazo" />
      {c.n.map((n, j) => <text x={x(i) + 14} y={112 + j * 28}>{n}</text>)}
      {i < capas.length - 1 && (
        <g>
          <path d={`M${x(i) + ancho + 3} 120 H${x(i + 1) - 4}`} class="trazo con-flecha" />
          <circle cx={x(i) + ancho + hueco / 2} cy="150" r="11" class="relleno-acento" />
          <text x={x(i) + ancho + hueco / 2} y="154.5" text-anchor="middle" class="t-num">{i + 1}</text>
        </g>
      )}
    </g>
  ))}
  {mappers.map((m, i) => (
    <g>
      <circle cx={30 + i * 250} cy="270" r="11" class="relleno-acento" />
      <text x={30 + i * 250} y="274.5" text-anchor="middle" class="t-num">{i + 1}</text>
      <text x={50 + i * 250} y="275" class="t-suave">{m}</text>
    </g>
  ))}
</Esquema>
